# forced add this files
!.gitignore


# discard folder/
instance/
__pycache__/
**/__pycache__/


# discard old foldes 
*_old*/
**/*_old*/

# discard old files
**/*_old*

# discard log files, para evitar el seguimiento accidental en el root
*.log
**/*.log

.venv/
**/.venv/


.bash_history
**/.bash_history